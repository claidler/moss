# Moss — example environment. Copy to .env / feed via your service manager.
# Everything is optional; defaults run a local fork without leaking any identity.

# Login Origin/Referer allowlist — REQUIRED once you deploy behind a hostname.
# MOSS_ALLOWED_HOSTS=moss.example.com,127.0.0.1

# Where the OpenClaw state directory lives (default: ~/.openclaw).
# MOSS_OPENCLAW_DIR=/home/you/.openclaw

# OpenClaw agent this Moss talks to (default: main).
# MOSS_AGENT_ID=main

# Gateway target (defaults shown).
# MOSS_GW_HOST=127.0.0.1
# MOSS_GW_PORT=18789

# Gateway auth token. Unset → read from $MOSS_OPENCLAW_DIR/openclaw.json at runtime.
# OPENCLAW_GATEWAY_TOKEN=

# Your chat handle; @handle pings are stripped from board notes and chat text. Empty → no stripping.
# MOSS_OWNER_HANDLE=alice

# VAPID contact sent to push services (default: mailto:admin@localhost).
# MOSS_PUSH_SUBJECT=mailto:you@example.com

# Groq key for composer dictation. Also read from $MOSS_ENV_FILE,
# ~/.openclaw/.env, or ~/.hermes/.env when set there.
# GROQ_API_KEY=
# MOSS_ENV_FILE=/etc/moss/env

# Store paths (defaults shown).
# MOSS_STORE_FILE=data/store.json
# MOSS_HISTORY_FILE=data/history.json
# MOSS_VAPID_FILE=data/vapid.json
# MOSS_PUSH_SUBS_FILE=data/push-subs.json

# When both are set, /.well-known/assetlinks.json is generated at runtime from
# these instead of the committed placeholder (see android/README.md).
# MOSS_ANDROID_PACKAGE=com.you.moss
# MOSS_ANDROID_FINGERPRINT=AA:BB:CC:...:32 hex pairs...
